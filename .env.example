# Application Settings
NEXT_PUBLIC_APP_NAME=Iconic Sports Complexes
NEXT_PUBLIC_APP_VERSION=1.0.0

# Database
DATABASE_PATH=public/databases/iconic-venues.xlsx

# Export Settings
EXPORT_MAX_FILE_SIZE=104857600
EXPORT_DEFAULT_RESOLUTION=300
EXPORT_DEFAULT_FORMAT=pdf

# API Settings
API_RATE_LIMIT=100
API_TIMEOUT=30000

# Feature Flags
ENABLE_AI_GENERATION=true
ENABLE_MARKETPLACE_EXPORT=true
ENABLE_ANALYTICS=false
