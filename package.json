{
  "name": "iconic-sports-complexes",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "electron desktop/main.cjs --dev",
    "desktop:prepare": "node desktop/prepare.cjs",
    "desktop:start": "npm run desktop:prepare && electron desktop/main.cjs",
    "test": "node --require ./scripts/register-typescript.cjs --test tests/*.test.cjs",
    "qa:visual": "node --require ./scripts/register-typescript.cjs scripts/visual-qa.cjs",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp"
  }
}
